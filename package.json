{
  "name": "bponder",
  "private": true,
  "workspaces": [
    "benchmark",
    "docs",
    "simulation-test",
    "examples/**",
    "packages/*",
    "tmp/*"
  ],
  "scripts": {
    "bench:ponder:ci": "bun run --filter './benchmark' benchmark",
    "build": "bun run --filter './packages/utils' build && bun run --filter './packages/client' build && bun run --filter './packages/core' build && bun run --filter './packages/react' build && bun run --filter './packages/create-ponder' build",
    "format": "biome format . --write",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "test": "bun run --filter '*' --parallel --no-exit-on-error test",
    "test:bun": "bun run --filter '*' --parallel --no-exit-on-error --if-present test:bun",
    "typecheck": "bun run --filter './packages/*' --sequential --if-present typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "drizzle-kit": "^0.30.6",
    "hono": "4.5.0",
    "typescript": "5.4.5",
    "viem": "2.35.0"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "esbuild"
  ],
  "packageManager": "bun@1.4.5",
  "engines": {
    "bun": ">=1.4.0"
  }
}
