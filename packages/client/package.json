{
  "name": "bponder-client",
  "version": "1.0.5",
  "description": "Client library for Ponder SQL over HTTP queries",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/chy3xyz/bponder",
    "directory": "packages/client"
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.bun.test.ts",
    "!src/**/*.test-d.ts",
    "!src/_test/**/*",
    "README.md",
    "tsconfig.json",
    "LICENSE"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "test:bun": "bun test",
    "test:typecheck": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "typescript": ">=5.4.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.0.1"
  }
}
