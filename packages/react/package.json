{
  "name": "@ponder/react",
  "version": "0.18.9",
  "description": "React hook library for Ponder SQL over HTTP queries",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chy3xyz/bponder",
    "directory": "packages/react"
  },
  "scripts": {
    "build": "tsx build.ts",
    "test": "bun test",
    "test:bun": "bun test",
    "test:typecheck": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist/**",
    "!dist/**/*.tsbuildinfo",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.bun.test.ts",
    "!src/**/*.test-d.ts",
    "!src/_test/**/*",
    "README.md",
    "tsconfig.json",
    "LICENSE"
  ],
  "sideEffects": false,
  "type": "module",
  "main": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "typings": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/esm/index.js"
    }
  },
  "peerDependencies": {
    "@ponder/client": ">=0.18.9",
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18",
    "typescript": ">=5.4.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ponder/client": "workspace:*",
    "@tanstack/react-query": "5.12.2",
    "@types/node": "^22.0.0",
    "@types/react": "18.2.37",
    "chokidar": "^4.0.3",
    "execa": "^8.0.1",
    "picocolors": "^1.0.0",
    "react": "^18.2.0",
    "rimraf": "^5.0.5",
    "tsx": "^4.19.2"
  }
}
